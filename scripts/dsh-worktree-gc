#!/usr/bin/env python3
"""Remove a finished Ticket's worktree and its branch, once the branch is gone from the remote.

A squash merge leaves no shared ancestry, so local history cannot prove the work is safe; the branch disappearing from
the remote is the proof that it was merged or deliberately deleted. Until then this refuses and changes nothing.
"""

import argparse
import os
import subprocess
import sys
from pathlib import Path


def git(*args: str, timeout: float | None = None) -> subprocess.CompletedProcess:
    """Run git without a terminal prompt: a cleanup that blocks on a credential prompt is worse than one that refuses."""
    try:
        return subprocess.run(['git', *args], capture_output=True, text=True, timeout=timeout,
                              env={**os.environ, 'GIT_TERMINAL_PROMPT': '0'})
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(['git', *args], 124, '', f'git timed out after {timeout}s')


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directory', help="The Ticket's worktree to remove.")
    parser.add_argument('--force', action='store_true',
                        help='Remove even when the branch is still on the remote or the worktree has uncommitted changes.')
    parser.add_argument('--dry-run', action='store_true', help='Report what would happen, then stop.')
    args = parser.parse_args()

    directory = Path(args.directory).resolve()
    if not directory.exists():
        print(f'{directory}: absent; nothing to remove')
        return 0

    common = git('-C', str(directory), 'rev-parse', '--path-format=absolute', '--git-common-dir')
    if common.returncode != 0:
        print(f'{directory}: not a git worktree; refusing to delete it')
        return 1
    clone = Path(common.stdout.strip()).parent

    listing = git('-C', str(clone), 'worktree', 'list', '--porcelain').stdout
    if f'worktree {directory}' not in listing.splitlines():
        print(f'{directory}: not a worktree of {clone}; refusing to delete it')
        return 1

    branch = git('-C', str(directory), 'rev-parse', '--abbrev-ref', 'HEAD').stdout.strip()
    if branch in ('HEAD', 'main', 'master'):
        print(f'{directory}: on {branch}, not a Ticket branch; refusing to delete it')
        return 1

    # The remote decides: a branch still there is work that may not be merged yet.
    remotes = git('-C', str(clone), 'remote').stdout.split()
    remote = remotes[0] if remotes else ''
    if not remote:
        print(f'{directory}: {clone} has no remote to check against; refusing', file=sys.stderr)
        return 1
    heads = git('-C', str(clone), 'ls-remote', '--heads', remote, branch, timeout=60)
    if heads.returncode != 0:
        print(f'{directory}: cannot reach {remote} to check the branch; refusing: {heads.stderr.strip()[:120]}', file=sys.stderr)
        return 1
    if heads.stdout.strip() and not args.force:
        print(f'{directory}: {branch} still exists on {remote}; refusing until it is merged or deleted there', file=sys.stderr)
        return 1

    dirty = git('-C', str(directory), 'status', '--porcelain').stdout.strip()
    if dirty and not (args.force or args.dry_run):
        print(f'{directory}: {len(dirty.splitlines())} uncommitted change(s); refusing without --force', file=sys.stderr)
        return 1

    if args.dry_run:
        print(f'{directory}: would remove worktree and branch {branch} (gone from {remote})')
        return 0

    removed = git('-C', str(clone), 'worktree', 'remove', '--force', str(directory))
    if removed.returncode != 0:
        print(f'{directory}: git refused to remove it: {removed.stderr.strip()}', file=sys.stderr)
        return 1
    git('-C', str(clone), 'branch', '-D', branch)
    git('-C', str(clone), 'worktree', 'prune')
    where = f'gone from {remote}' if not heads.stdout.strip() else 'still on the remote, forced'
    print(f'{directory}: removed worktree and branch {branch} ({where})')
    return 0


if __name__ == '__main__':
    sys.exit(main())
